# Mark3 Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit actual credentials.
#
# Quickstart: run ./setup.sh for guided setup with validation.

# ============================================================
# REQUIRED: Atlassian Jira Cloud
# ============================================================
# Your Atlassian Cloud URL (no trailing slash)
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Your Atlassian account email
ATLASSIAN_EMAIL=you@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# Jira project key for Mark3 to write stories/epics into (e.g. SCRUM, PROJ)
JIRA_PROJECT_KEY=SCRUM

# ============================================================
# REQUIRED: Anthropic API (for direct cloud mode)
# ============================================================
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================================
# REQUIRED: Context Graph (element35-mcp)
# ============================================================
# Absolute path to the element35-mcp directory
# Source: https://github.com/karthik-gct/AIHarness_Mark1
ELEMENT35_MCP_ROOT=/path/to/AIHarness_Mark1/context-graph-rag/element35-mcp

# ============================================================
# OPTIONAL: Model Router (STARK)
# Only needed when models.config.yaml routing_backend = "stark"
# ============================================================
STARK_ROOT=/path/to/STARK
STARK_ENDPOINT=http://localhost:8000

# ============================================================
# OPTIONAL: Google Gemini (used by element35-mcp for embeddings)
# ============================================================
GOOGLE_API_KEY=
