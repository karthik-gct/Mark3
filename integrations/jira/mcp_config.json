      "ATLASSIAN_BASE_URL": "https://karthik-gct.atlassian.net",
      "ATLASSIAN_EMAIL": "karthik_gct@live.com",
      "ATLASSIAN_API_TOKEN": "<see .env file — never commit actual token>"
    }
  },
  "activeProject": {
    "key": "SCRUM",
